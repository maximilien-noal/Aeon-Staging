<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Aeon.Emulator.Launcher">
    <!-- Dim when paused -->
    <Style Selector="local|EmulatorDisplay[EmulatorState=Paused]">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <!-- Hide cursor when running in absolute mode -->
    <Style Selector="local|EmulatorDisplay[EmulatorState=Running][MouseInputMode=Absolute]">
        <Setter Property="Cursor" Value="None" />
    </Style>
    <!-- Hide cursor when running with mouse captured -->
    <Style Selector="local|EmulatorDisplay[EmulatorState=Running][IsMouseCursorCaptured=True]">
        <Setter Property="Cursor" Value="None" />
    </Style>
    <!-- Dim on program exited (animated fade matching WPF 2-second DoubleAnimation) -->
    <Style Selector="local|EmulatorDisplay[EmulatorState=ProgramExited]">
        <Style.Animations>
            <Animation Duration="0:0:2" FillMode="Forward">
                <KeyFrame Cue="0%">
                    <Setter Property="Opacity" Value="1.0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="Opacity" Value="0.5" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>
</Styles>
