<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Aeon.Emulator.Launcher.TaskDialog"
        x:Name="root" Width="320" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" CanResize="False">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBlock Name="captionText" Margin="0,0,0,10" Foreground="DarkBlue" FontSize="16" TextWrapping="Wrap" />
        <ItemsControl Name="itemsControl" Grid.Row="1" />
    </Grid>
</Window>
