<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aeon.Emulator.Launcher.NumericUpDown"
             x:Name="root">
    <Grid ColumnDefinitions="*,Auto" RowDefinitions="*,*">
        <TextBox Name="valueText" Grid.RowSpan="2" Text="0" IsReadOnly="{Binding #root.IsReadOnly}" TextAlignment="Right" />
        <Button Name="upButton" Grid.Column="1" Width="20" Click="UpButton_Click">
            <Polygon Points="3,0 6,3 0,3" Fill="Black" Stroke="Black" />
        </Button>
        <Button Name="downButton" Grid.Column="1" Grid.Row="1" Width="20" Click="DownButton_Click">
            <Polygon Points="0,0 3,3 6,0" Fill="Black" Stroke="Black" />
        </Button>
    </Grid>
</UserControl>
